# Copy to backend/.env for local dev (gitignored). On Railway, set these as
# service Variables instead of committing a .env file.

# LLM for translation + PDF structure analysis: openai or anthropic (default: anthropic if set, else openai).
# LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_ANALYZER_MODEL=gpt-4o
# OPENAI_TRANSLATOR_MODEL=gpt-4o

# Optional: style-reference RAG embeddings via OpenAI (see pipeline/embeddings.py).
# EMBEDDING_PROVIDER=openai
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-large
# EMBEDDING_DIM=3072

# Optional overrides (defaults shown):
# ANALYZER_MODE=claude                 # set "heuristic" to force offline mode
# ANALYZER_MODEL=claude-opus-4-8       # structure-analysis model
# TRANSLATOR_MODEL=claude-opus-4-8     # translation model

# Where uploaded PDFs, page assets, and translation caches are written.
# Local default is ./storage. On Railway, point this at the mounted volume,
# e.g. STORAGE_DIR=/data/storage  (with a volume mounted at /data).
# STORAGE_DIR=./storage
